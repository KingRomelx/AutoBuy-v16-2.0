--================================================================================
-- UTILITY FUNCTIONS (UPGRADED MATH FOR K/M/B)
--================================================================================
local function formatNumber(n)
    local formatted = tostring(math.floor(tonumber(n) or 0))
    local k
    while true do
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
        if k == 0 then break end
    end
    return formatted
end

local function cleanInput(str)
    local s = tostring(str)
    s = string.gsub(s, "[$,]", "")
    local numStr, suffix = string.match(s, "([%d%.]+)([KkMmBb]?)")
    if not numStr then return 0 end
    local val = tonumber(numStr) or 0
    suffix = string.upper(suffix)
    if suffix == "K" then val = val * 1000
    elseif suffix == "M" then val = val * 1000000
    elseif suffix == "B" then val = val * 1000000000
    end
    return val
end

            for _, desc in ipairs(shoeFrame:GetDescendants()) do
                if desc.Name ~= "IndexStar" and (desc:IsA("ImageLabel") or desc:IsA("ImageButton")) then
                    local foundId = extractId(desc.Image)
                    if foundId then imageId = foundId break end
                end
            end
        end

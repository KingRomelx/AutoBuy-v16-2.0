_G.JarvisUpdateLists = function()
    for _, list in pairs({searchList, badProfitsList, dupList, lowTargetsList}) do
        if list then
            for _, v in ipairs(list:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
        end
    end
    
    local searchFilter = searchBox.Text:lower()
    local badProfitsFilter = badProfitsBox.Text:lower()
    
    local lowTargetsData = {}
    local badProfitsData = {}
    local dupesToRender = {}
    local exactTracker = {}

    for _, shoe in ipairs(presetSneakers) do
        local abVal = shoeMaxPrices[shoe.full] or shoe.default or 0
        local marketVal = marketPrices[shoe.full] or 0
        local profit = marketVal - abVal
        
        local lowerName = shoe.full:lower()
        local cleanName = string.match(lowerName, "^%s*(.-)%s*$") or lowerName
        local exactKey = cleanName .. "_" .. tostring(abVal)
        
        local isDuplicate = false
        if exactTracker[exactKey] then 
            isDuplicate = true 
        else
            exactTracker[exactKey] = true
        end
        
        -- DYNAMIC RARITY FILTER LOGIC
        local itemRarity = shoeRarities[shoe.full] and string.upper(shoeRarities[shoe.full]) or "UNKNOWN"
        local passesRarity = (currentRarityFilter == "ALL") or (itemRarity == currentRarityFilter)
        
        if lowerName:find(searchFilter) and passesRarity then
            createSearchShoeFrame(searchList, shoe, marketVal, abVal, profit, itemRarity)
        end
        
        if marketVal > 0 and profit <= 0 and lowerName:find(badProfitsFilter) then
            table.insert(badProfitsData, {shoe = shoe, marketVal = marketVal, profit = profit})
        end
        
        if isDuplicate and not dupesToRender[exactKey] then
            dupesToRender[exactKey] = shoe
        end
        
        if marketVal > 0 and abVal > 0 and abVal < (marketVal * 0.7) then
            local missed = marketVal - abVal
            table.insert(lowTargetsData, {shoe = shoe, marketVal = marketVal, profit = profit, abVal = abVal, missed = missed})
        end
    end
    
    table.sort(badProfitsData, function(a, b) return a.profit < b.profit end)
    table.sort(lowTargetsData, function(a, b) return a.missed > b.missed end)
    
    local dupCount = 0
    for _, shoe in pairs(dupesToRender) do
        createDuplicateShoeFrame(dupList, shoe)
        dupCount = dupCount + 1
    end

    for _, data in ipairs(badProfitsData) do
        createReadOnlyShoeFrame(badProfitsList, data.shoe, data.marketVal, data.profit, nil, RED)
    end
    
    for _, data in ipairs(lowTargetsData) do
        createReadOnlyShoeFrame(lowTargetsList, data.shoe, data.marketVal, data.profit, "Market: $"..formatNumber(data.marketVal).." | Target: $"..formatNumber(data.abVal).." | Missed potential: $"..formatNumber(data.missed), BLUE)
    end
    
    searchList.CanvasSize = UDim2.new(0, 0, 0, searchLayout.AbsoluteContentSize.Y + 50)
    badProfitsList.CanvasSize = UDim2.new(0, 0, 0, (#badProfitsData * 110) + 50)
    dupList.CanvasSize = UDim2.new(0, 0, 0, dupCount * 115)
    lowTargetsList.CanvasSize = UDim2.new(0, 0, 0, #lowTargetsData * 110)
end


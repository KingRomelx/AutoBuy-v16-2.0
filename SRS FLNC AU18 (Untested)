local indexFrame = LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("MainScreenGui"):WaitForChild("IndexFrame"):WaitForChild("ScrollingFrame")

local function fuzzyFindFrame(folder, searchName)
    if not folder then return nil end
    local cleanSearch = string.match(searchName, "^%s*(.-)%s*$")
    local exact = folder:FindFirstChild(cleanSearch)
    if exact then return exact end
    
    local bestMatch = nil
    local highestScore = 0
    local searchLower = cleanSearch:lower()
    
    for _, child in ipairs(folder:GetChildren()) do
        local childLower = child.Name:lower()
        if string.find(searchLower, childLower, 1, true) or string.find(childLower, searchLower, 1, true) then return child end
        
        local score = 0
        for word in string.gmatch(searchLower, "%S+") do
            if string.find(childLower, word, 1, true) then score = score + 1 end
        end
        if score > highestScore and score >= 2 then
            highestScore = score
            bestMatch = child
        end
    end
    return bestMatch
end

local function getInGameShoeImage(shoeName)
    local cleanShoeName = string.match(shoeName, "^%s*(.-)%s*$")
    
    local shoeFrame = fuzzyFindFrame(indexFrame, cleanShoeName)
    if shoeFrame then
        if shoeFrame:IsA("ImageLabel") or shoeFrame:IsA("ImageButton") then return shoeFrame.Image end
        for _, desc in ipairs(shoeFrame:GetDescendants()) do
            if desc.Name ~= "IndexStar" and (desc:IsA("ImageLabel") or desc:IsA("ImageButton")) then return desc.Image end
        end
    end
    
    local invFrame = fuzzyFindFrame(gameInvGui, cleanShoeName)
    if invFrame then 
        if invFrame:IsA("ImageLabel") or invFrame:IsA("ImageButton") then return invFrame.Image end
        for _, desc in ipairs(invFrame:GetDescendants()) do
            if desc.Name ~= "IndexStar" and (desc:IsA("ImageLabel") or desc:IsA("ImageButton")) then return desc.Image end
        end
    end
    
    return ""
end

local function LoadPrices()
    if isfile and readfile and isfile(saveFileName) then
        local success, decoded = pcall(function() return HttpService:JSONDecode(readfile(saveFileName)) end)
        if success and type(decoded) == "table" then
            for shoeName, savedPrice in pairs(decoded) do
                shoeMaxPrices[shoeName] = savedPrice
                local found = false
                for _, p in ipairs(presetSneakers) do
                    if p.full == shoeName then found = true break end
                end
                if not found then
                    table.insert(presetSneakers, 1, {label=shoeName, full=shoeName, default=savedPrice})
                end
            end
        end
    end
end

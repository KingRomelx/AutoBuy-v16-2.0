local function fetchMarketData()
    local success, stockPrices = pcall(function() return ReplicatedStorage.RemoteEvents.GetStockYPrices:InvokeServer() end)
    if success and type(stockPrices) == "table" then
        for name, price in pairs(stockPrices) do
            if marketPrices[name] then
                if price > marketPrices[name] then priceTrends[name] = "UP"
                elseif price < marketPrices[name] then priceTrends[name] = "DOWN"
                else priceTrends[name] = "STABLE" end
            end
            marketPrices[name] = price
        end
    end
end

local function processSnipeWithWait(who, shoe, price, initialSeller)
    local cleanPriceNum = cleanInput(price)
    local searchKey = shoe .. "_" .. tostring(cleanPriceNum)
    
    -- LOG THE BUYER FOR THE LIVE FEED ENGINE
    _G.RecentBuyers = _G.RecentBuyers or {}
    _G.RecentBuyers[searchKey] = who

    -- Only proceed if the buyer is us
    if not (string.find(who, LocalPlayer.Name) or string.find(who, LocalPlayer.DisplayName)) then return end

    task.spawn(function()
        local finalSeller = initialSeller
        local attempts = 0
        
        -- WAIT LOOP: Give the Live Feed cache up to 5 seconds to grab the seller data
        while (not finalSeller or finalSeller == "") and attempts < 10 do
            if _G.LiveListingCache and _G.LiveListingCache[searchKey] then
                finalSeller = _G.LiveListingCache[searchKey]
                break
            end
            attempts = attempts + 1
            task.wait(0.5)
        end

        -- Formatting the seller name nicely if we finally got it
        local sellerDisplay = "Unknown"
        if finalSeller and finalSeller ~= "" then
            local cleanUser = string.gsub(finalSeller, "[^%w_]", "")
            local p = Players:FindFirstChild(cleanUser)
            sellerDisplay = p and p.DisplayName .. " (@" .. cleanUser .. ")" or cleanUser
        end

        -- Attempt to fire the webhook (sendSnipeWebhook will block it if it's still Unknown)
        sendSnipeWebhook(shoe, price, sellerDisplay)
    end)
end

local function onChatMessage(rawMessage)
    local cleanMessage = string.gsub(rawMessage, "<[^>]+>", "") 
    local who, shoe, price, sellerUser = string.match(cleanMessage, "(%S+) has bought the (.-) for (%S+) from (%S+)")
    
    if not who then 
        who, shoe, price = string.match(cleanMessage, "(%S+) has bought the (.-) for (%S+)") 
    end
    
    if who and shoe and price then
        processSnipeWithWait(who, shoe, price, sellerUser)
    end
end


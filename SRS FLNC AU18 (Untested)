local function createSearchShoeFrame(parentList, shoe, marketVal, abVal, profit, rarityTag)
    local itemFrame = Instance.new("Frame", parentList)
    itemFrame.Size = UDim2.new(1, -20, 0, 100)
    itemFrame.BackgroundColor3 = Color3.fromRGB(0, 30, 0)
    
    local nameLbl = Instance.new("TextLabel", itemFrame)
    nameLbl.Size = UDim2.new(0.55, 0, 0.4, 0)
    nameLbl.Text = " [" .. rarityTag .. "] " .. shoe.full
    nameLbl.TextColor3 = rarityColors[rarityTag] or GREEN
    nameLbl.Font = Enum.Font.Code
    nameLbl.TextSize = 20
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
    nameLbl.BackgroundTransparency = 1
    
    local profitLbl = Instance.new("TextLabel", itemFrame)
    profitLbl.Size = UDim2.new(0.55, 0, 0.4, 0)
    profitLbl.Position = UDim2.new(0, 0, 0.4, 0)
    if marketVal == 0 then
        profitLbl.Text = " MARKET: UNKNOWN | PROFIT: N/A"
        profitLbl.TextColor3 = YELLOW
    else
        profitLbl.Text = " MARKET: $" .. formatNumber(marketVal) .. " | PROFIT: $" .. formatNumber(profit)
        profitLbl.TextColor3 = profit > 0 and GREEN or RED
    end
    profitLbl.Font = Enum.Font.Code
    profitLbl.TextSize = 16
    profitLbl.TextXAlignment = Enum.TextXAlignment.Left
    profitLbl.BackgroundTransparency = 1

    local priceEdit = Instance.new("TextBox", itemFrame)
    priceEdit.Size = UDim2.new(0.25, 0, 0.6, 0)
    priceEdit.Position = UDim2.new(0.56, 0, 0.2, 0)
    priceEdit.Text = formatNumber(abVal)
    priceEdit.BackgroundColor3 = Color3.fromRGB(0, 60, 0)
    priceEdit.TextColor3 = Color3.new(1, 1, 1)
    priceEdit.Font = Enum.Font.Code
    priceEdit.TextSize = 22
    priceEdit.ClearTextOnFocus = false 
    
    priceEdit.FocusLost:Connect(function()
        local val = cleanInput(priceEdit.Text)
        if val > 0 then
            shoeMaxPrices[shoe.full] = val 
            priceEdit.Text = formatNumber(val)
            SavePrices() 
        else
            priceEdit.Text = formatNumber(shoeMaxPrices[shoe.full])
        end
        if _G.JarvisUpdateLists then _G.JarvisUpdateLists() end
    end)

    local delBtn = Instance.new("TextButton", itemFrame)
    delBtn.Size = UDim2.new(0.15, 0, 0.6, 0)
    delBtn.Position = UDim2.new(0.83, 0, 0.2, 0)
    delBtn.BackgroundColor3 = Color3.fromRGB(80, 0, 0)
    delBtn.TextColor3 = Color3.new(1, 1, 1)
    delBtn.Font = Enum.Font.Code
    delBtn.TextSize = 18
    delBtn.Text = "DELETE"
    Instance.new("UIStroke", delBtn).Color = Color3.fromRGB(150, 0, 0)
    
    delBtn.MouseButton1Click:Connect(function()
        shoeMaxPrices[shoe.full] = nil
        for i, p in ipairs(presetSneakers) do
            if p.full == shoe.full then table.remove(presetSneakers, i) break end
        end
        SavePrices()
        if _G.JarvisUpdateLists then _G.JarvisUpdateLists() end
    end)
end


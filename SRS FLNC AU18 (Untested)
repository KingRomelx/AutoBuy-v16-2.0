-- Helper function to convert long numbers into clean K/M/B suffixes
-- Helper function to convert long numbers into clean K/M/B/T/Q suffixes
local function formatSuffix(numStr)
    local cleanStr = string.gsub(numStr, "[$,]", "") -- Strip symbols so math works
    local num = tonumber(cleanStr)
    if not num then return numStr end
    
    if num >= 1000000000000000 then
        return "$" .. string.format("%.1fQ", num / 1000000000000000) -- Quadrillions
    elseif num >= 1000000000000 then
        return "$" .. string.format("%.1fT", num / 1000000000000) -- Trillions
    elseif num >= 1000000000 then
        return "$" .. string.format("%.1fB", num / 1000000000) -- Billions
    elseif num >= 1000000 then
        return "$" .. string.format("%.1fM", num / 1000000) -- Millions
    elseif num >= 1000 then
        return "$" .. string.format("%.1fK", num / 1000) -- Thousands
    else
        return "$" .. tostring(math.floor(num))
    end
end


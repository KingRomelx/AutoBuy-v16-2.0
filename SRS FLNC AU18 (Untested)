local consoleMessageId = nil
local chatHistory = {}
local lastLoggedMessage = ""
local MAX_CHAT_LINES = 40 -- Increased capacity! 

local function updateChatConsole(speaker, message)
    if CHAT_WEBHOOK_URL == "" then return end
    
    local cleanMsg = string.gsub(message, "<[^>]+>", "")
    local logString = "**" .. speaker .. ":** " .. cleanMsg
    
    -- Prevent duplicate messages from dual-chat engines
    if logString == lastLoggedMessage then return end
    lastLoggedMessage = logString
    
    local timeStr = os.date("%I:%M:%S %p")
    table.insert(chatHistory, "`[" .. timeStr .. "]` " .. logString)
    
    local fullText = table.concat(chatHistory, "\n")
    
    -- Trigger a new message block if we hit 40 lines OR get dangerously close to Discord's 4,096 character limit
    local hitLimit = false
    if #chatHistory >= MAX_CHAT_LINES or string.len(fullText) > 3800 then
        hitLimit = true
    end
    
    local data = {
        ["embeds"] = {{
            ["title"] = "🖥️ STERLING ENTERPRISE : SERVER CHAT",
            ["description"] = fullText,
            ["color"] = 3447003, -- Blue
            ["footer"] = {["text"] = "Sterling Live Console • Auto-Updating"}
        }}
    }
    
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not req then return end
    
    task.spawn(function()
        if not consoleMessageId then
            -- Post a brand new message block
            local res = req({
                Url = CHAT_WEBHOOK_URL .. "?wait=true",
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(data)
            })
            if res and res.Body then
                local success, decoded = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if success and decoded and decoded.id then
                    consoleMessageId = decoded.id
                end
            end
        else
            -- Update the existing message block
            req({
                Url = CHAT_WEBHOOK_URL .. "/messages/" .. consoleMessageId,
                Method = "PATCH",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(data)
            })
        end
        
        -- If this update maxed out the block, wipe the slate clean so the next chat starts a new message
        if hitLimit then
            consoleMessageId = nil
            chatHistory = {}
        end
    end)
end


local activeTracerDetails = nil

local function clearTracer()
    if activeTracerDetails then
        pcall(function()
            if activeTracerDetails.att0 then activeTracerDetails.att0:Destroy() end
            if activeTracerDetails.att1 then activeTracerDetails.att1:Destroy() end
            if activeTracerDetails.beam then activeTracerDetails.beam:Destroy() end
        end)
        activeTracerDetails = nil
    end
end

local function createTracer(targetPlayer)
    clearTracer() -- Ensures we never have double beams
    
    local lp = Players.LocalPlayer
    local lpChar = lp.Character
    local tpChar = targetPlayer.Character
    
    if lpChar and lpChar:FindFirstChild("HumanoidRootPart") and tpChar and tpChar:FindFirstChild("HumanoidRootPart") then
        local att0 = Instance.new("Attachment")
        att0.Parent = lpChar.HumanoidRootPart
        
        local att1 = Instance.new("Attachment")
        att1.Parent = tpChar.HumanoidRootPart
        
        local beam = Instance.new("Beam")
        beam.Color = ColorSequence.new(Color3.fromRGB(200, 0, 255)) -- Purple Laser
        beam.FaceCamera = true
        beam.Width0 = 0.3
        beam.Width1 = 0.3
        beam.LightEmission = 1 -- Makes it glow in the dark
        beam.Transparency = NumberSequence.new(0.2)
        beam.Attachment0 = att0
        beam.Attachment1 = att1
        beam.Parent = att0
        
        activeTracerDetails = {att0 = att0, att1 = att1, beam = beam}
    end
end


local function getPlayerNetworth(p)
    local ls = p:FindFirstChild("leaderstats")
    local cash = (ls and ls:FindFirstChild("Money")) and ls.Money.Value or 0
    local inv = p:FindFirstChild("Inventory")
    local unsellable = inv and inv:FindFirstChild("UnsellableInventory")
    local shoeValue = 0
    if unsellable then
        for _, item in pairs(unsellable:GetChildren()) do
            if marketPrices[item.Name] then shoeValue = shoeValue + (marketPrices[item.Name] * (item.Value or 1)) end
        end
    end
    return cash + shoeValue
end

local function performScan(targetPlayerName)
    local targetPlayer = Players:FindFirstChild(targetPlayerName)
    if not targetPlayer then return end
    selectedPlayerName = targetPlayerName
    viewSkippedButton.Visible, nw_backButton.Visible = false, false
    lastSkippedItems = {}
    resultsLabel.Text = "CONNECTING TO " .. targetPlayer.Name .. "'S DATA...\n"

    local inventory = targetPlayer:WaitForChild("Inventory", 2)
    local unsellable = inventory and inventory:WaitForChild("UnsellableInventory", 2)
    local moneyFolder = targetPlayer:WaitForChild("leaderstats", 2)
    local money = moneyFolder and moneyFolder:WaitForChild("Money", 2)

    if not unsellable or not money then resultsLabel.Text = "[ERROR] INVENTORY STRUCTURE INCORRECT." return end
    local totalSneakerValue = 0

    resultsLabel.Text = resultsLabel.Text .. "CALCULATING...\n"
    for _, item in pairs(unsellable:GetChildren()) do
        local price = marketPrices[item.Name]
        if price then totalSneakerValue = totalSneakerValue + (price * item.Value)
        else table.insert(lastSkippedItems, {name = item.Name, qty = item.Value or 1}) end
    end

    resultsLabel.Text = "RESULTS FOR @" .. targetPlayer.Name .. "\n\nSNEAKER WORTH: $" .. formatNumber(totalSneakerValue) .. "\nCASH: $" .. formatNumber(money.Value) .. "\n-----------------------------\nTOTAL WORTH: $" .. formatNumber(totalSneakerValue + money.Value) .. "\n\nSKIPPED: " .. #lastSkippedItems .. " ITEMS"
    if #lastSkippedItems > 0 then
        viewSkippedButton.Visible = true
        viewSkippedButton.Text = "VIEW SKIPPED (" .. #lastSkippedItems .. ")"
    end
end

local function updateDropdown()
    for _, child in pairs(nw_scrollFrame:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    local text = string.lower(nw_searchBox.Text)
    local filteredPlayers = {}
    for _, p in pairs(Players:GetPlayers()) do
        if string.find(string.lower(p.Name), text) or string.find(string.lower(p.DisplayName), text) then table.insert(filteredPlayers, p) end
    end
    
    table.sort(filteredPlayers, function(a, b)
        return getPlayerNetworth(a) > getPlayerNetworth(b)
